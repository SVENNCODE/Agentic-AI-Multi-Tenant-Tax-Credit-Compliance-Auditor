# Copy to `.env` in the project root and fill in real values before running
# `docker compose up --build`. This file itself is safe to commit; the
# copy named `.env` is gitignored and must never be committed.
#
# Supabase now issues two key formats side by side during its migration
# off JWT-based keys:
#   - anon key / service_role key: legacy JWTs, start with "eyJ..."
#   - publishable key / secret key: new format, start with "sb_publishable_"
#     / "sb_secret_"
# Both formats are equally valid; use whichever your project's API Settings
# page currently shows you and match the variable name the code actually
# reads (backend/app reads SUPABASE_ANON_KEY as a JWT; the frontend reads
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY). Either key format works in both
# places -- the names below just have to match what the code imports.

# --- Backend (server-only secrets) ---
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key
ANTHROPIC_API_KEY=your-anthropic-api-key
ALLOWED_ORIGINS=http://localhost:3000
ENABLE_API_DOCS=false
QUESTIONNAIRE_RATE_LIMIT=5/minute

# --- Frontend (public, inlined into the browser bundle at build time) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key
NEXT_PUBLIC_API_URL=http://localhost:8000
