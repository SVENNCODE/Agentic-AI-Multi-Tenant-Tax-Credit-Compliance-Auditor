# Copy to backend/.env and fill in real values. NEVER commit backend/.env.
# All values below are server-only secrets except SUPABASE_URL / SUPABASE_ANON_KEY.

SUPABASE_URL=https://your-project-ref.supabase.co
# Public by design (role "anon"); used only to build per-user RLS-scoped clients.
SUPABASE_ANON_KEY=your-anon-or-publishable-key
# SERVER-ONLY. Bypasses RLS. Never expose to the browser or prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SERVER-ONLY.
ANTHROPIC_API_KEY=sk-ant-your-key

# Comma-separated list of browser origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:3000
# Set to "true" only in local development to expose /docs and /openapi.json.
ENABLE_API_DOCS=false
# slowapi limit for POST /api/v1/questionnaire/save
QUESTIONNAIRE_RATE_LIMIT=5/minute
# Max accepted request body size in bytes.
MAX_REQUEST_BODY_BYTES=65536

# Only used by the manual integration scripts (test_integration.py).
TEST_USER_ID=00000000-0000-0000-0000-000000000000
